<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="searchforge"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [${APP_NAME}] [req=%X{requestId:-none}] [%thread] %logger{36} : %msg%n%wEx</pattern>
        </encoder>
    </appender>

    <springProfile name="prod">
        <root level="${LOG_LEVEL_ROOT:-WARN}">
            <appender-ref ref="STDOUT"/>
        </root>
        <logger name="com.searchforge" level="${LOG_LEVEL_APP:-INFO}"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>

    <springProfile name="!prod">
        <root level="${LOG_LEVEL_ROOT:-INFO}">
            <appender-ref ref="STDOUT"/>
        </root>
        <logger name="com.searchforge" level="${LOG_LEVEL_APP:-INFO}"/>
    </springProfile>
</configuration>
