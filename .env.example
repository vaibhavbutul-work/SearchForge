# ==============================================================================
# SearchForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with secure settings.
# NEVER commit .env or real secrets to version control.

# --- Spring Boot Profile & Server ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=searchforge_db
DB_USERNAME=searchforge
DB_PASSWORD=replace_with_your_secure_password
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=3
# Use 'validate' once Flyway migrations are active; 'update' only for initial non-migrated bootstrap
JPA_DDL_AUTO=validate

# --- Administrative Security (Minimum 16 random characters) ---
SEARCHFORGE_ADMIN_API_KEY=replace_with_your_admin_api_key

# --- CORS & Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8080

# --- Semantic Embeddings & ONNX Model ---
SEMANTIC_EMBEDDING_MODEL_TYPE=onnx
SEARCHFORGE_MODEL_PATH=/app/models/all-MiniLM-L6-v2.onnx
SEMANTIC_EMBEDDING_ALLOW_FALLBACK=false

# --- Rate Limiting ---
RATE_LIMIT_SEARCH_RPM=60
RATE_LIMIT_SEARCH_BURST=20
RATE_LIMIT_ADMIN_RPM=20
RATE_LIMIT_ADMIN_BURST=5

# --- Logging ---
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
